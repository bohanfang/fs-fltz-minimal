import FsFltz.Geometry.VerticalMaslovFamily
import Mathlib.Geometry.Manifold.PartitionOfUnity

/-!
# Canonical corrections preserving prescribed interval sections

Source: `geoemtric-part-fsf.tex`, `def:maslov`, lines 212–244, and
`sec:lean`, lines 794–814.

A smooth ambient tensor extension need not be canonical away from the
parameter interval. On a neighborhood carrying an actual smooth complex
structure, inverse-coframe evaluation followed by the determinant-square
generator corrects that tensor to a canonical one. Reconstruction proves
that the correction equals the original tensor at every interval point.
Nonvanishing at the distinguished interval point produces an open
neighborhood on which the corrected section stays nonzero. Partition of
unity glues corrections on a whole open parameter–spatial chart, with
singleton constraints fixing every original interval value. The nonzero
locus then gives an open neighborhood of the entire interval chart slab.

The neighborhood includes the two parameter endpoints and need not contain
a uniform larger time interval. There is no time substitution or change
to the prescribed two-form. `CompatibleComplexExtension` constructs the
local genuine-complex extension from the original interval family.
Whole-chart gluing here still assumes a supplied smooth complex structure;
compatibility with a two-form outside the interval is not required.
Coframe-dependent corrections are combined by partition of unity; they
are not asserted to agree off the interval.
-/

noncomputable section
open scoped Manifold ContDiff Topology
open Set Filter

namespace FsFltz.Geometry

/-- Correction to the canonical line generated by a chosen complex coframe.
This formula is defined for arbitrary ambient tensors. -/
def canonicalCoframeCorrection {n : ℕ}
    (C : Model (2 * n) →L[ℝ] TangentCoordinates n)
    (s : SquaredCanonicalTensor n) : SquaredCanonicalTensor n :=
  squaredCoframeCoefficient C s • coframeSquaredGenerator C

theorem canonicalCoframeCorrection_canonical {n : ℕ}
    (C : Model (2 * n) →L[ℝ] TangentCoordinates n)
    (J : Model (2 * n) →L[ℝ] Model (2 * n))
    (hC : ∀ v, C (J v) = coordinateComplexStructure n (C v))
    (s : SquaredCanonicalTensor n) :
    IsSquaredCanonicalTensor J (canonicalCoframeCorrection C s) :=
  (squaredCanonicalSubmodule J).smul_mem _ (coframeSquaredGenerator_canonical C J hC)

/-- Canonical tensors are fixed pointwise, rather than only up to homotopy. -/
theorem canonicalCoframeCorrection_eq {n : ℕ}
    (C : Model (2 * n) →L[ℝ] TangentCoordinates n) (hinv : C.IsInvertible)
    (J : Model (2 * n) →L[ℝ] Model (2 * n))
    (hC : ∀ v, C (J v) = coordinateComplexStructure n (C v))
    (s : SquaredCanonicalTensor n) (hs : IsSquaredCanonicalTensor J s) :
    canonicalCoframeCorrection C s = s :=
  (squaredCoframe_reconstruction C hinv J hC s hs).symm

theorem canonicalCoframeCorrection_ne_zero {n : ℕ}
    (C : Model (2 * n) →L[ℝ] TangentCoordinates n) (hinv : C.IsInvertible)
    (s : SquaredCanonicalTensor n) (hs : squaredCoframeCoefficient C s ≠ 0) :
    canonicalCoframeCorrection C s ≠ 0 :=
  smul_ne_zero hs (coframeSquaredGenerator_ne_zero C hinv)

theorem contDiffOn_canonicalCoframeCorrection {n : ℕ} {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] {U : Set E}
    {C : E → Model (2 * n) →L[ℝ] TangentCoordinates n}
    {s : E → SquaredCanonicalTensor n}
    (hC : ContDiffOn ℝ ∞ C U) (hinv : ∀ x ∈ U, (C x).IsInvertible)
    (hs : ContDiffOn ℝ ∞ s U) :
    ContDiffOn ℝ ∞ (fun x => canonicalCoframeCorrection (C x) (s x)) U :=
  (contDiffOn_squaredCoframeCoefficient hC hinv hs).smul
    (contDiffOn_coframeSquaredGenerator hC)

/-- A supplied ambient tensor is corrected to a smooth nonvanishing
canonical section near a canonical nonzero point. All values on the
prescribed canonical locus are preserved literally. No corrected section
or open nonvanishing neighborhood is an input. -/
theorem exists_smooth_local_canonicalCorrection {n : ℕ} {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    {U A : Set E} {p : E} (hU : IsOpen U) (hpU : p ∈ U) (hpA : p ∈ A)
    {J : E → Model (2 * n) →L[ℝ] Model (2 * n)}
    (hJ : ContDiffOn ℝ ∞ J U) (hJsq : ∀ x ∈ U, ∀ v, J x (J x v) = -v)
    {s : E → SquaredCanonicalTensor n} (hs : ContDiffOn ℝ ∞ s U)
    (hcanonical : ∀ x ∈ U ∩ A, IsSquaredCanonicalTensor (J x) (s x))
    (hzero : s p ≠ 0) :
    ∃ V ⊆ U, IsOpen V ∧ p ∈ V ∧
      ∃ q : E → SquaredCanonicalTensor n,
        ContDiffOn ℝ ∞ q V ∧
        (∀ x ∈ V, IsSquaredCanonicalTensor (J x) (q x)) ∧
        (∀ x ∈ V, q x ≠ 0) ∧ (∀ x ∈ V ∩ A, q x = s x) := by
  obtain ⟨C₀, W, hWU, hWo, hpW, hC, hinv, hCJ⟩ :=
    exists_smooth_local_complexCoframe hU hpU hJ hJsq
  let C := fun x => projectedComplexCoframe C₀ (J x)
  have hsW := hs.mono hWU
  have hc : ContDiffOn ℝ ∞ (fun x => squaredCoframeCoefficient (C x) (s x)) W :=
    contDiffOn_squaredCoframeCoefficient hC hinv hsW
  have hcp : squaredCoframeCoefficient (C p) (s p) ≠ 0 := by
    intro hz
    have he := squaredCoframe_reconstruction (C p) (hinv p hpW) (J p)
      (hCJ p hpW) (s p) (hcanonical p ⟨hpU, hpA⟩)
    rw [hz] at he
    exact hzero (he.trans (zero_smul ℂ (coframeSquaredGenerator (C p))))
  have hcn := (hc.contDiffAt (hWo.mem_nhds hpW)).continuousAt.eventually_ne hcp
  obtain ⟨N, hN, hNo, hpN⟩ := mem_nhds_iff.mp hcn
  refine ⟨N ∩ W, inter_subset_right.trans hWU, hNo.inter hWo, ⟨hpN, hpW⟩,
    fun x => canonicalCoframeCorrection (C x) (s x), ?_, ?_, ?_, ?_⟩
  · exact (contDiffOn_canonicalCoframeCorrection hC hinv hsW).mono inter_subset_right
  · intro x hx
    exact canonicalCoframeCorrection_canonical (C x) (J x) (hCJ x hx.2) (s x)
  · intro x hx
    exact canonicalCoframeCorrection_ne_zero (C x) (hinv x hx.2) (s x) (hN hx.1)
  · intro x hx
    exact canonicalCoframeCorrection_eq (C x) (hinv x hx.1.2) (J x)
      (hCJ x hx.1.2) (s x) (hcanonical x ⟨hWU hx.1.2, hx.2⟩)

section Gluing

variable {E H B : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [TopologicalSpace H] [TopologicalSpace B] [ChartedSpace H B]
  {I : ModelWithCorners ℝ E H} [FiniteDimensional ℝ E]
  [IsManifold I ∞ B] [SigmaCompactSpace B] [T2Space B] {n : ℕ}

/-- Partition of unity glues coframe corrections, fixing a prescribed
canonical tensor on a closed locus. The constraints are singleton fibers
on that locus and the canonical vector subspace elsewhere, so they are
convex. This applies to an open parameter–spatial chart, without requiring
a complex structure on the whole time axis. -/
theorem exists_contMDiff_canonicalExtension_of_closed
    {J : B → Model (2 * n) →L[ℝ] Model (2 * n)}
    (hJ : ContMDiff I 𝓘(ℝ, Model (2 * n) →L[ℝ] Model (2 * n)) ∞ J)
    (hJsq : ∀ x v, J x (J x v) = -v)
    {s : B → SquaredCanonicalTensor n}
    (hs : ContMDiff I 𝓘(ℝ, SquaredCanonicalTensor n) ∞ s)
    {A : Set B} (hA : IsClosed A)
    (hcanonical : ∀ x ∈ A, IsSquaredCanonicalTensor (J x) (s x)) :
    ∃ q : B → SquaredCanonicalTensor n,
      ContMDiff I 𝓘(ℝ, SquaredCanonicalTensor n) ∞ q ∧
      (∀ x, IsSquaredCanonicalTensor (J x) (q x)) ∧ EqOn q s A := by
  classical
  let T : B → Set (SquaredCanonicalTensor n) := fun x =>
    if x ∈ A then {s x} else (squaredCanonicalSubmodule (J x)).restrictScalars ℝ
  have hconv : ∀ x, Convex ℝ (T x) := by
    intro x
    by_cases hx : x ∈ A
    · simpa only [T, ite_eq_left hx] using convex_singleton (s x)
    · simpa only [T, ite_eq_right hx] using
        ((squaredCanonicalSubmodule (J x)).restrictScalars ℝ).convex
  have hlocal : ∀ x : B, ∃ W ∈ 𝓝 x, ∃ g : B → SquaredCanonicalTensor n,
      ContMDiffOn I 𝓘(ℝ, SquaredCanonicalTensor n) ∞ g W ∧
        ∀ y ∈ W, g y ∈ T y := by
    intro x
    by_cases hx : x ∈ A
    · obtain ⟨c, hxc⟩ := exists_verticalCanonicalChart hJ hJsq x
      refine ⟨c.domain, c.isOpen_domain.mem_nhds hxc,
        fun y => canonicalCoframeCorrection (c.coframe y) (s y), ?_, ?_⟩
      · have hm : ContDiff ℝ ∞ (fun z : ℂ × SquaredCanonicalTensor n => z.1 • z.2) :=
          contDiff_fst.smul contDiff_snd
        exact hm.contMDiff.comp_contMDiffOn
          ((c.smooth_coefficient c.isOpen_domain (Subset.refl _) s hs.contMDiffOn).prodMk_space
            c.smooth_squaredGenerator)
      · intro y hy
        by_cases hyA : y ∈ A
        · simp only [T, ite_eq_left hyA, mem_singleton_iff]
          exact canonicalCoframeCorrection_eq (c.coframe y) (c.invertible_coframe y hy)
            (J y) (c.intertwines_coframe y hy) (s y) (hcanonical y hyA)
        · simp only [T, ite_eq_right hyA]
          exact canonicalCoframeCorrection_canonical (c.coframe y) (J y)
            (c.intertwines_coframe y hy) (s y)
    · refine ⟨Aᶜ, hA.isOpen_compl.mem_nhds hx, fun _ => 0, contMDiffOn_const, ?_⟩
      intro y hy
      simp only [T, ite_eq_right hy]
      exact (squaredCanonicalSubmodule (J y)).zero_mem
  obtain ⟨q, hq⟩ := exists_contMDiffMap_forall_mem_convex_of_local I hconv hlocal
  refine ⟨q, q.contMDiff, ?_, ?_⟩
  · intro x
    by_cases hx : x ∈ A
    · have he : q x = s x := by simpa only [T, ite_eq_left hx, mem_singleton_iff] using hq x
      rw [he]
      exact hcanonical x hx
    · have hc := hq x
      simp only [T, ite_eq_right hx] at hc
      change IsSquaredCanonicalTensor (J x) (q x) at hc
      exact hc
  · intro x hx
    simpa only [T, ite_eq_left hx, mem_singleton_iff] using hq x

/-- The glued canonical tensor is nonzero on an open neighborhood of the
entire prescribed locus; no uniform enlargement of the parameter interval
or compactness of the spatial domain is used. -/
theorem exists_contMDiff_nonvanishingCanonicalExtension_of_closed
    {J : B → Model (2 * n) →L[ℝ] Model (2 * n)}
    (hJ : ContMDiff I 𝓘(ℝ, Model (2 * n) →L[ℝ] Model (2 * n)) ∞ J)
    (hJsq : ∀ x v, J x (J x v) = -v)
    {s : B → SquaredCanonicalTensor n}
    (hs : ContMDiff I 𝓘(ℝ, SquaredCanonicalTensor n) ∞ s)
    {A : Set B} (hA : IsClosed A)
    (hcanonical : ∀ x ∈ A, IsSquaredCanonicalTensor (J x) (s x))
    (hzero : ∀ x ∈ A, s x ≠ 0) :
    ∃ q : B → SquaredCanonicalTensor n,
      ContMDiff I 𝓘(ℝ, SquaredCanonicalTensor n) ∞ q ∧
      (∀ x, IsSquaredCanonicalTensor (J x) (q x)) ∧ EqOn q s A ∧
      ∃ V : TopologicalSpace.Opens B, A ⊆ V ∧ ∀ x ∈ V, q x ≠ 0 := by
  obtain ⟨q, hq, hc, he⟩ := exists_contMDiff_canonicalExtension_of_closed hJ hJsq hs hA hcanonical
  refine ⟨q, hq, hc, he, ⟨{x | q x ≠ 0}, isOpen_ne_fun hq.continuous continuous_const⟩, ?_, ?_⟩
  · intro x hx
    change q x ≠ 0
    rw [he hx]
    exact hzero x hx
  · intro x hx
    exact hx

end Gluing

namespace MaslovFamily

/-- Once a local complex-structure extension has been produced, the given
Maslov family produces its local smooth nonvanishing canonical section
extension. Every original interval value in the neighborhood is fixed.
The ambient two-form remains `eta`, and no time reparametrization occurs.

The hypothesis concerns only the complex structure. It assumes neither
the corrected section nor its nonvanishing outside the interval. -/
theorem exists_local_prescribedSectionExtension {n : ℕ}
    {M : SmoothManifold (2 * n)} {eta : ℝ → M.Form 2}
    (f : MaslovFamily M eta) (a : M.Point)
    {U : Set (ℝ × Model (2 * n))} (hU : IsOpen U)
    {K : (ℝ × Model (2 * n)) → Model (2 * n) →L[ℝ] Model (2 * n)}
    (hK : ContDiffOn ℝ ∞ K U)
    (hKsq : ∀ p ∈ U, ∀ v, K p (K p v) = -v)
    (hagree : ∀ p ∈ U ∩ (parameterInterval ×ˢ (chartAt (Model (2 * n)) a).target),
      K p = almostComplexInChart M a (f.J p.1) p.2)
    {p : ℝ × Model (2 * n)} (hpU : p ∈ U)
    (hp : p ∈ parameterInterval ×ˢ (chartAt (Model (2 * n)) a).target) :
    ∃ V ⊆ U ∩ (univ ×ˢ (chartAt (Model (2 * n)) a).target),
      IsOpen V ∧ p ∈ V ∧
      ∃ q : (ℝ × Model (2 * n)) → SquaredCanonicalTensor n,
        ContDiffOn ℝ ∞ q V ∧
        (∀ z ∈ V, IsSquaredCanonicalTensor (K z) (q z)) ∧
        (∀ z ∈ V, q z ≠ 0) ∧
        (∀ z ∈ V ∩ (parameterInterval ×ˢ (chartAt (Model (2 * n)) a).target),
          q z = squaredTensorInChart M a (f.tensor z.1) z.2) := by
  obtain ⟨S, hSo, hSsub, hs⟩ := f.smoothSection a
  let D := U ∩ S ∩ (univ ×ˢ (chartAt (Model (2 * n)) a).target)
  have hDo : IsOpen D := (hU.inter hSo).inter
    (isOpen_univ.prod (chartAt (Model (2 * n)) a).open_target)
  have hpD : p ∈ D := ⟨⟨hpU, hSsub hp⟩, ⟨mem_univ _, hp.2⟩⟩
  have hDU : D ⊆ U := fun _ hz => hz.1.1
  have hDS : D ⊆ S := fun _ hz => hz.1.2
  have hcan : ∀ z ∈ D ∩
      (parameterInterval ×ˢ (chartAt (Model (2 * n)) a).target),
      IsSquaredCanonicalTensor (K z) (squaredTensorInChart M a (f.tensor z.1) z.2) := by
    intro z hz
    rw [hagree z ⟨hDU hz.1, hz.2⟩]
    exact squaredTensorInChart_canonical M a (f.J z.1) (f.tensor z.1)
      (f.canonical z.1 hz.2.1) z.2 hz.2.2
  have hnz := squaredTensorInChart_ne_zero M a (f.tensor p.1)
    (f.nowhereZero p.1 hp.1) p.2 hp.2
  obtain ⟨V, hVD, hVo, hpV, q, hq, hqcan, hqnz, heq⟩ :=
    exists_smooth_local_canonicalCorrection hDo hpD hp
      (hK.mono hDU) (fun z hz => hKsq z (hDU hz)) (hs.mono hDS) hcan hnz
  exact ⟨V, fun z hz => ⟨hDU (hVD hz), (hVD hz).2⟩,
    hVo, hpV, q, hq, hqcan, hqnz, heq⟩

/-- On an entire parameter–spatial chart, partition of unity constructs a
canonical tensor extension and its nonvanishing open neighborhood of the
whole interval slab. The section is fixed at every interval value. The
supplied complex structure is used at its original parameter values, and
the ambient two-form `eta` is never reparametrized.

The output neighborhood is open in the open chart domain `D`; it need not
contain a uniform larger time interval. This is an auxiliary construction:
a genuine complex extension `K` is supplied, without off-interval symplectic
compatibility. The native interval-bundle route does not require a single
such extension over all spatial charts. -/
theorem exists_chart_prescribedSectionExtension {n : ℕ}
    {M : SmoothManifold (2 * n)} {eta : ℝ → M.Form 2}
    (f : MaslovFamily M eta) (a : M.Point)
    {U : Set (ℝ × Model (2 * n))} (hU : IsOpen U)
    (hslab : parameterInterval ×ˢ (chartAt (Model (2 * n)) a).target ⊆ U)
    {K : (ℝ × Model (2 * n)) → Model (2 * n) →L[ℝ] Model (2 * n)}
    (hK : ContDiffOn ℝ ∞ K U)
    (hKsq : ∀ p ∈ U, ∀ v, K p (K p v) = -v)
    (hagree : ∀ p ∈ parameterInterval ×ˢ (chartAt (Model (2 * n)) a).target,
      K p = almostComplexInChart M a (f.J p.1) p.2) :
    ∃ D : TopologicalSpace.Opens (ℝ × Model (2 * n)),
      parameterInterval ×ˢ (chartAt (Model (2 * n)) a).target ⊆ D ∧
      (D : Set (ℝ × Model (2 * n))) ⊆ U ∩
        (univ ×ˢ (chartAt (Model (2 * n)) a).target) ∧
      ∃ q : D → SquaredCanonicalTensor n,
        ContMDiff 𝓘(ℝ, ℝ × Model (2 * n)) 𝓘(ℝ, SquaredCanonicalTensor n) ∞ q ∧
        (∀ p : D, IsSquaredCanonicalTensor (K p) (q p)) ∧
        (∀ p : D, p.val.1 ∈ parameterInterval →
          q p = squaredTensorInChart M a (f.tensor p.val.1) p.val.2) ∧
        ∃ V : TopologicalSpace.Opens D,
          {p : D | p.val.1 ∈ parameterInterval} ⊆ V ∧ ∀ p ∈ V, q p ≠ 0 := by
  obtain ⟨S, hSo, hSsub, hs⟩ := f.smoothSection a
  let D : TopologicalSpace.Opens (ℝ × Model (2 * n)) :=
    ⟨U ∩ S ∩ (univ ×ˢ (chartAt (Model (2 * n)) a).target),
      (hU.inter hSo).inter (isOpen_univ.prod (chartAt (Model (2 * n)) a).open_target)⟩
  let : LocallyCompactSpace D := D.isOpen.locallyCompactSpace
  have hDU : (D : Set (ℝ × Model (2 * n))) ⊆ U := fun _ hp => hp.1.1
  have hDS : (D : Set (ℝ × Model (2 * n))) ⊆ S := fun _ hp => hp.1.2
  have hKD : ContMDiff 𝓘(ℝ, ℝ × Model (2 * n))
      𝓘(ℝ, Model (2 * n) →L[ℝ] Model (2 * n)) ∞ (fun p : D => K p) := by
    intro p
    exact contMDiffAt_subtype_iff.mpr (contMDiffAt_iff_contDiffAt.mpr
      ((hK.mono hDU).contDiffAt (D.isOpen.mem_nhds p.property)))
  have hsD : ContMDiff 𝓘(ℝ, ℝ × Model (2 * n))
      𝓘(ℝ, SquaredCanonicalTensor n) ∞
      (fun p : D => squaredTensorInChart M a (f.tensor p.val.1) p.val.2) := by
    intro p
    exact contMDiffAt_subtype_iff.mpr (contMDiffAt_iff_contDiffAt.mpr
      ((hs.mono hDS).contDiffAt (D.isOpen.mem_nhds p.property)))
  let A : Set D := {p | p.val.1 ∈ parameterInterval}
  have hAc : IsClosed A := isClosed_Icc.preimage
    (continuous_fst.comp continuous_subtype_val)
  have hcan : ∀ p ∈ A, IsSquaredCanonicalTensor (K p)
      (squaredTensorInChart M a (f.tensor p.val.1) p.val.2) := by
    intro p hp
    rw [hagree p ⟨hp, p.property.2.2⟩]
    exact squaredTensorInChart_canonical M a (f.J p.val.1) (f.tensor p.val.1)
      (f.canonical p.val.1 hp) p.val.2 p.property.2.2
  have hnz : ∀ p ∈ A, squaredTensorInChart M a (f.tensor p.val.1) p.val.2 ≠ 0 := by
    intro p hp
    exact squaredTensorInChart_ne_zero M a (f.tensor p.val.1)
      (f.nowhereZero p.val.1 hp) p.val.2 p.property.2.2
  obtain ⟨q, hq, hqc, heq, V, hAV, hVnz⟩ :=
    exists_contMDiff_nonvanishingCanonicalExtension_of_closed hKD
      (fun p => hKsq p (hDU p.property)) hsD hAc hcan hnz
  refine ⟨D, ?_, ?_, q, hq, hqc, heq, V, hAV, hVnz⟩
  · intro p hp
    exact ⟨⟨hslab hp, hSsub hp⟩, ⟨mem_univ _, hp.2⟩⟩
  · intro p hp
    exact ⟨hDU hp, hp.2⟩

end MaslovFamily

end FsFltz.Geometry
