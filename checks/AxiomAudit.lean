/-!
Reproducible transitive axiom audit of the imported project surface, including
generated declarations and private project names. Run from the project root:
`lake env lean checks/AxiomAudit.lean`.

This verifies axiom provenance; it does not prove the defined target or
establish source fidelity of its representations.
-/

open Lean Elab Command

set_option maxRecDepth 4096 in
set_option maxHeartbeats 8000000 in
run_cmd do
  let env ← getEnv
  let mut count : Nat := 0
  for (name, _) in env.constants.toList do
    let text := name.toString
    if text.startsWith "FsFltz." || text.startsWith "_private.FsFltz." then
      let axioms ← Lean.collectAxioms name
      let unexpected := axioms.filter fun ax =>
        ax != ``propext && ax != ``Classical.choice && ax != ``Quot.sound
      unless unexpected.isEmpty do
        throwError "Unexpected transitive axioms for {name}: {unexpected}"
      count := count + 1
  logInfo m!"Audited {count} project declarations: only propext, Classical.choice, Quot.sound."

